# Maintainer: Tino Didriksen <mail@tinodidriksen.com>
pkgname=cg3
pkgver=1.6.9+g2350~a027fe68
pkgrel=1
pkgdesc='Tools for using the 3rd edition of Constraint Grammar (CG-3)'
url='https://edu.visl.dk/cg3.html'
license=('GPL3')
makedepends=('boost' 'gperftools' 'cmake' 'rapidjson' 'swig' 'python-setuptools')
depends=('icu' 'perl' 'sqlite3' 'python')
arch=('i686' 'x86_64' 'aarch64' 'armv7h')
source=("https://apertium.projectjj.com/apt/nightly/source/$pkgname/${pkgname}_$pkgver.orig.tar.bz2")
sha256sums=('SKIP')
conflicts=('vislcg3')
provides=('vislcg3')
replaces=('vislcg3')
options=('lto')

build() {
	cd "$srcdir/$pkgname-$pkgver"
	cmake -DENABLE_PYTHON_BINDINGS=ON -DCMAKE_INSTALL_PREFIX=/usr .
	make
}

check() {
	cd "$srcdir/$pkgname-$pkgver"
	make test
	./test/runall.pl
}

package () {
	cd "$srcdir/$pkgname-$pkgver"
	make DESTDIR="$pkgdir/" install
}
