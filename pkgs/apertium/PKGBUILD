# Maintainer: Tino Didriksen <mail@tinodidriksen.com>
pkgname=apertium
pkgver=3.9.12+g943~c0a91d81
pkgrel=1
pkgdesc='Shallow-transfer machine translation engine'
url='https://apertium.org/'
license=('GPL2')
makedepends=('zlib' 'utf8cpp' 'zip' 'unzip' 'python-lxml')
depends=('lttoolbox' 'transfuse' 'gawk' 'libxslt' 'libxml2' 'icu')
arch=('i686' 'x86_64' 'aarch64' 'armv7h')
source=("https://apertium.projectjj.com/apt/nightly/source/$pkgname/${pkgname}_$pkgver.orig.tar.bz2")
sha256sums=('SKIP')
options=('lto')

build() {
	cd "$srcdir/$pkgname-$pkgver"
	autoreconf -fvi
	./configure --disable-static --enable-python-bindings --prefix=/usr
	make
}

# Null-flush test fails

package() {
	cd "$srcdir/$pkgname-$pkgver"
	make DESTDIR="$pkgdir/" install
}
