# Maintainer: Tino Didriksen <mail@tinodidriksen.com>
pkgname=apertium-lex-tools
pkgver=0.5.0+g549~e993adc7
pkgrel=1
pkgdesc='Constraint-based lexical selection module'
url='https://apertium.org/'
license=('GPL3')
makedepends=('python-setuptools' 'swig')
depends=('lttoolbox' 'libxml2' 'icu' 'python' 'irstlm')
arch=('i686' 'x86_64' 'aarch64' 'armv7h')
source=("https://apertium.projectjj.com/apt/nightly/source/$pkgname/${pkgname}_$pkgver.orig.tar.bz2")
sha256sums=('SKIP')
options=('lto')

build() {
	cd "$srcdir/$pkgname-$pkgver"
	autoreconf -fvi
	./configure --enable-yasmet --enable-irstlm --enable-python-bindings --prefix=/usr
	make
}

check() {
	cd "$srcdir/$pkgname-$pkgver"
	make check
}

package() {
	cd "$srcdir/$pkgname-$pkgver"
	make DESTDIR="$pkgdir/" install
}
