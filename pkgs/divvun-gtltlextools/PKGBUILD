pkgname=python-gtltlextools
_name=divvun-gtltlextools
pkgver=0.10.0+g83~d73db33a
pkgrel=1
pkgdesc='Divvun tools to manipulate a corpus in different ways'
url='https://github.com/divvun/GiellaLTLexTools'
license=('Apache')
makedepends=('python-poetry' 'python-setuptools')
depends=('cython' 'python-pyhfst')
arch=('i686' 'x86_64' 'aarch64' 'armv7h')
source=("https://apertium.projectjj.com/apt/nightly/source/$_name/${_name}_$pkgver.orig.tar.bz2")
sha256sums=('SKIP')
provides=($_name)

package() {
	cd "$srcdir/$_name-$pkgver"
	python3 -m pip install --prefix=/usr "--root=$pkgdir/" -I --no-deps .
}
