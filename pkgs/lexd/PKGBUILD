# Maintainer: Tino Didriksen <mail@tinodidriksen.com>
pkgname=lexd
pkgver=1.3.5+g180~55b0b7b6
pkgrel=1
pkgdesc='Lexicon compiler for non-suffixational morphologies'
url='https://github.com/apertium/lexd'
license=('GPL3')
makedepends=('hfst')
depends=('lttoolbox' 'icu')
arch=('i686' 'x86_64' 'aarch64' 'armv7h')
source=("https://apertium.projectjj.com/apt/nightly/source/$pkgname/${pkgname}_$pkgver.orig.tar.bz2")
sha256sums=('SKIP')
options=('lto')

build() {
	cd "$srcdir/$pkgname-$pkgver"
	autoreconf -fvi
	./configure --prefix=/usr
	make
}

check() {
	cd "$srcdir/$pkgname-$pkgver"
	make check
}

package() {
	cd "$srcdir/$pkgname-$pkgver"
	make DESTDIR="$pkgdir/" install
}
