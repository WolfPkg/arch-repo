# Maintainer: Tino Didriksen <mail@tinodidriksen.com>
pkgname=apertium-separable
pkgver=0.7.1+g279~18045e4d
pkgrel=1
pkgdesc='Reordering separable/discontiguous multiwords'
url='https://apertium.org/'
license=('GPL3')
makedepends=('python')
depends=('lttoolbox' 'libxml2' 'icu')
arch=('i686' 'x86_64' 'aarch64' 'armv7h')
source=("https://apertium.projectjj.com/apt/nightly/source/$pkgname/${pkgname}_$pkgver.orig.tar.bz2")
sha256sums=('SKIP')
options=('lto')

build() {
	cd "$srcdir/$pkgname-$pkgver"
	autoreconf -fvi
	./configure --prefix=/usr
	make
}

check() {
	cd "$srcdir/$pkgname-$pkgver"
	make check
}

package() {
	cd "$srcdir/$pkgname-$pkgver"
	make DESTDIR="$pkgdir/" install
}
