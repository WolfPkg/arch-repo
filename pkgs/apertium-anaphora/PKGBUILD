# Maintainer: Tino Didriksen <mail@tinodidriksen.com>
pkgname=apertium-anaphora
pkgver=1.1.1+g121~0e32f8f3
pkgrel=1
pkgdesc='Anaphora resolution module for Apertium'
url='https://apertium.org/'
license=('GPL3')
depends=('lttoolbox' 'libxml2' 'icu')
arch=('i686' 'x86_64' 'aarch64' 'armv7h')
source=("https://apertium.projectjj.com/apt/nightly/source/$pkgname/${pkgname}_$pkgver.orig.tar.bz2")
sha256sums=('SKIP')
options=('lto')

build() {
	cd "$srcdir/$pkgname-$pkgver"
	autoreconf -fvi
	./configure --prefix=/usr
	make
}

check() {
	cd "$srcdir/$pkgname-$pkgver"
	make check
}

package() {
	cd "$srcdir/$pkgname-$pkgver"
	make DESTDIR="$pkgdir/" install
}
